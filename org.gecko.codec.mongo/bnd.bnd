-library: enable-emf

-buildpath: \
	org.gecko.codec.emfjson;version=project,\
	org.gecko.codec,\
	org.mongodb.mongo-java-driver,\
	org.gecko.mongo.osgi.api,\
	org.gecko.emf.collections,\
	org.gecko.codec.info;version=latest,\
	org.gecko.codec.info.model;version=latest,\
	tools.jackson.core.jackson-core,\
	tools.jackson.core.jackson-databind,\
	com.fasterxml.jackson.core.jackson-annotations;version='3.0'