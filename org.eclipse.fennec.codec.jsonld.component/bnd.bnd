-library: enable-emf
-buildpath: \
	org.gecko.emf.osgi.example.model.basic,\
	com.apicatalog.titanium.json.ld,\
	org.eclipse.fennec.jsonld.model;version=latest,\
	tools.jackson.core.jackson-databind,\
	tools.jackson.core.jackson-core,\
	com.fasterxml.jackson.core.jackson-annotations;version='3.0'
	
-includeresource: \
	data/=data/