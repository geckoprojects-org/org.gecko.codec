<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER/org.eclipse.jdt.internal.debug.ui.launcher.StandardVMType/JavaSE-17">
		<attributes>
			<attribute name="module" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="con" path="aQute.bnd.classpath.container"/>
	<classpathentry kind="src" output="bin" path="src"/>
	<classpathentry kind="src" output="bin_test" path="test">
		<attributes>
			<attribute name="test" value="true"/>
		</attributes>
	</classpathentry>
	<classpathentry kind="src" path="src-annotations"/>
	<classpathentry kind="src" path="src-array"/>
	<classpathentry kind="src" path="src-generics"/>
	<classpathentry kind="src" path="src-model"/>
	<classpathentry kind="src" path="src-package-annotations"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
