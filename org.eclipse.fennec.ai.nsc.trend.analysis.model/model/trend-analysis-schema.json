{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "http://eclipse.org/fennec/ai/trendanalysis/1.0/schema",
  "title": "TrendAnalysis",
  "description": "Schema for Trend Analysis documents based on the Fennec AI NSC Trend Analysis Model",
  "type": "object",
  "properties": {
    "document_metadata": {
      "type": "object",
      "description": "Metadata about the analyzed document",
      "properties": {
        "document_id": {
          "type": "string",
          "description": "Unique identifier for the document"
        },
        "title": {
          "type": "string",
          "description": "Title of the document"
        },
        "name": {
          "type": "string",
          "description": "Name of the document"
        },
        "source": {
          "type": "string",
          "description": "Source of the document"
        },
        "legislative_period": {
          "type": "string",
          "description": "Legislative period associated with the document"
        },
        "date": {
          "type": "string",
          "format": "date-time",
          "description": "Date of the document"
        },
        "total_pages": {
          "type": "integer",
          "description": "Total number of pages in the document"
        },
        "issuing_authority": {
          "type": "string",
          "description": "Authority that issued the document"
        },
        "analysis_date": {
          "type": "string",
          "format": "date-time",
          "description": "Date when the analysis was performed"
        }
      },
      "required": ["document_id", "title", "name", "source", "legislative_period", "date", "total_pages", "issuing_authority", "analysis_date"]
    },
    "executive_summary": {
      "type": "object",
      "description": "Executive summary of the trend analysis",
      "properties": {
        "context": {
          "type": "string",
          "description": "Context of the analysis"
        },
        "scope": {
          "type": "string",
          "description": "Scope of the analysis"
        },
        "time_horizon": {
          "type": "string",
          "description": "Time horizon covered by the analysis"
        },
        "key_focus": {
          "type": "string",
          "description": "Key focus areas of the analysis"
        }
      },
      "required": ["context", "scope", "time_horizon", "key_focus"]
    },
    "trends": {
      "type": "array",
      "description": "List of identified trends",
      "items": {
        "$ref": "#/definitions/Trend"
      }
    }
  },
  "definitions": {
    "Trend": {
      "type": "object",
      "description": "A structural trend identified in the analysis",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the trend"
        },
        "title": {
          "type": "string",
          "description": "Title of the trend"
        },
        "description": {
          "type": "string",
          "description": "Detailed description of the trend"
        },
        "time_horizon": {
          "type": "string",
          "description": "Time horizon of the trend (3-5+ years)"
        },
        "primary_stempel_category": {
          "$ref": "#/definitions/StempelCategoryType",
          "description": "Primary STEMPEL category classification"
        },
        "secondary_stempel_categories": {
          "type": "array",
          "description": "Secondary STEMPEL category classifications",
          "maxItems": 3,
          "items": {
            "$ref": "#/definitions/StempelCategoryType"
          }
        },
        "page_reference": {
          "type": "array",
          "description": "Page numbers where the trend is referenced",
          "items": {
            "type": "integer"
          }
        },
        "evidence": {
          "type": "array",
          "description": "Evidence supporting the trend",
          "items": {
            "type": "string"
          }
        },
        "implications": {
          "type": "array",
          "description": "Implications of the trend",
          "items": {
            "type": "string"
          }
        },
        "related_item_ids": {
          "type": "array",
          "description": "IDs of related items (trends, risks, drivers)",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["id", "title", "description", "time_horizon", "primary_stempel_category", "page_reference", "evidence"]
    },
    "StempelCategoryType": {
      "type": "string",
      "description": "STEMPEL (Social, Technological, Economic, External Security, Internal Security, Political, Ecological) category classification",
      "enum": [
        "SOCIAL",
        "TECHNOLOGICAL",
        "ECONOMIC_GEO_ECONOMIC",
        "EXTERNAL_SECURITY",
        "INTERNAL_SECURITY",
        "POLITICAL_GEO_POLITICAL",
        "ECOLOGICAL_PLANETARY"
      ]
    }
  }
}
