-library: enable-emf

-buildpath: \
	com.fasterxml.jackson.core.jackson-annotations;version=latest,\
	tools.jackson.core.jackson-core,\
	tools.jackson.core.jackson-databind,\
	org.eclipse.fennec.codec.constants
	
-testpath.guava: \
	com.google.guava;version=latest

src= \
	${^src}, \
	src-annotations,\
	src-generics,\
	src-model,\
	src-array,\
	src-package-annotations

# The code generation takes a bit of time and makes the build a bit slower.
# It might be a good idea to put comments around it, when you don't need it
-generate:\
	test-data/model/annotations.genmodel;\
		generate=geckoEMF;\
		genmodel=test-data/model/annotations.genmodel;\
		output=src-annotations,\
	test-data/model/generics.genmodel;\
		generate=geckoEMF;\
		genmodel=test-data/model/generics.genmodel;\
		output=src-generics,\
	test-data/model/model.genmodel;\
		generate=geckoEMF;\
		genmodel=test-data/model/model.genmodel;\
		output=src-model,\
	test-data/model/array.genmodel;\
		generate=geckoEMF;\
		genmodel=test-data/model/array.genmodel;\
		output=src-array,\
	test-data/model/packageAnnotations.genmodel;\
		generate=geckoEMF;\
		genmodel=test-data/model/packageAnnotations.genmodel;\
		output=src-package-annotations

Bundle-Name: Eclipse Fennec Codec EMFJson Jackson
Bundle-Description: Fork of EMFJson Jackson
