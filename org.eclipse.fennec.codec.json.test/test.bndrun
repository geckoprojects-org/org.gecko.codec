-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.codec.json',\
	bnd.identity;id='org.eclipse.fennec.codec.json.test',\
	bnd.identity;id='org.eclipse.fennec.ai.ecore.jsonschema.mmt',\
