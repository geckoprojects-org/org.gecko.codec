    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The client's response to a roots/list request from the server.&#xA;This result contains an array of Root objects, each representing a root directory&#xA;or file that the server can operate on."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="_meta" eType="//ArtificialSchema40" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="roots" lowerBound="1" upperBound="-1" eType="//Root"/>
  </eClassifiers>
