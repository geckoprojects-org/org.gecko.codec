  <eClassifiers xsi:type="ecore:EClass" name="GetPromptResult">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The server's response to a prompts/get request from the client."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="_meta" eType="//ArtificialSchema20" containment="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="description">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An optional description for the prompt."/>
      </eAnnotations>
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
