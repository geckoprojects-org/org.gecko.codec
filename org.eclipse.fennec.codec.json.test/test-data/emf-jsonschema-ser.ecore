  <eClassifiers xsi:type="ecore:EClass" name="ListRootsRequest">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Sent from the server to request a list of root URIs from the client. Roots allow&#xA;servers to ask for specific directories or files to operate on. A common example&#xA;for roots is providing a set of repositories or directories a server should operate&#xA;on.&#xA;&#xA;This request is typically used when the server needs to understand the file system&#xA;structure or access specific locations that the client has permission to read from."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="method" lowerBound="1">
      <eType xsi:type="ecore:EDataType" href="http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" name="params" eType="//ArtificialSchema39" containment="true"/>
  </eClassifiers>
