-library: enable-emf
Bundle-Name: Eclipse Fennec Codec 
Bundle-Description: Eclipse Fennec Project Codec Framework

-buildpath: \
	org.osgi.util.promise;version=latest,\
	org.eclipse.fennec.codec.info.model,\
	org.eclipse.fennec.codec.info,\
	org.eclipse.fennec.codec.constants,\
	com.fasterxml.jackson.core.jackson-annotations;version='3.0',\
	tools.jackson.core.jackson-core,\
	tools.jackson.core.jackson-databind,\
	org.gecko.emf.util.model
	
-testpath: \
	org.eclipse.fennec.codec.test.models;version=project
