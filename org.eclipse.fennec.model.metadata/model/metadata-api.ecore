<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="api" nsURI="https://eclipse.org/fennec/metadata/api/1.0.0" nsPrefix="metadata.api">
  <eAnnotations source="Version">
    <details key="value" value="1.0"/>
  </eAnnotations>
  <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
    <details key="complianceLevel" value="17.0"/>
    <details key="oSGiCompatible" value="true"/>
    <details key="basePackage" value="org.eclipse.fennec.model.metadata"/>
    <details key="copyrightText" value="Copyright (c) 2012 - 2026 Data In Motion and others.&#xA;All rights reserved.&#xA;&#xA;This program and the accompanying materials are made&#xA;available under the terms of the Eclipse Public License 2.0&#xA;which is available at https://www.eclipse.org/legal/epl-2.0/&#xA;&#xA;SPDX-License-Identifier: EPL-2.0&#xA;&#xA;Contributors:&#xA;    Data In Motion - initial API and implementation&#xA;"/>
    <details key="rootExtendsInterface" value=""/>
  </eAnnotations>

  <!-- ========================================================================
       MetadataIndexReader - Query operations (public API)
       ======================================================================== -->
  <eClassifiers xsi:type="ecore:EClass" name="MetadataIndexReader" abstract="true" interface="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Read-only query interface for metadata lookups. Provides fast indexed queries for ClassMetadata and FeatureMetadata by various criteria."/>
    </eAnnotations>
    <!-- Query by instanceClassName (for CLASS TypeStrategy) -->
    <eOperations name="findByInstanceClassName" eType="ecore:EClass metadata.ecore#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Find ClassMetadata by Java instanceClassName within a specific package. Returns null if not found. Used by CLASS TypeStrategy deserialization."/>
      </eAnnotations>
      <eParameters name="nsURI" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="instanceClassName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="findAllByInstanceClassName" upperBound="-1" eType="ecore:EClass metadata.ecore#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Find all ClassMetadata with matching Java instanceClassName across all indexed packages. May return multiple results (e.g., java.util.Map$Entry pattern). Used by CLASS TypeStrategy deserialization when no context schema is available."/>
      </eAnnotations>
      <eParameters name="instanceClassName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <!-- Query by class name (for NAME TypeStrategy) -->
    <eOperations name="findByClassName" eType="ecore:EClass metadata.ecore#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Find ClassMetadata by EClass name within a specific package. Returns null if not found. Used by NAME TypeStrategy deserialization."/>
      </eAnnotations>
      <eParameters name="nsURI" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="className" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="findAllByClassName" upperBound="-1" eType="ecore:EClass metadata.ecore#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Find all ClassMetadata with matching EClass name across all indexed packages."/>
      </eAnnotations>
      <eParameters name="className" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <!-- Query by URI (for URI TypeStrategy) -->
    <eOperations name="findClassByURI" eType="ecore:EClass metadata.ecore#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Find ClassMetadata by its full EMF URI. Used by URI TypeStrategy deserialization."/>
      </eAnnotations>
      <eParameters name="uri" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="findFeatureByURI" eType="ecore:EClass metadata.ecore#//FeatureMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Find FeatureMetadata by its full EMF URI."/>
      </eAnnotations>
      <eParameters name="uri" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <!-- Query by annotation -->
    <eOperations name="findClassesByAnnotation" upperBound="-1" eType="ecore:EClass metadata.ecore#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Find all ClassMetadata where the EClass has an annotation with the given source, key, and value. Pass null for value to match any value."/>
      </eAnnotations>
      <eParameters name="annotationSource" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="key" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="findFeaturesByAnnotation" upperBound="-1" eType="ecore:EClass metadata.ecore#//FeatureMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Find all FeatureMetadata where the EStructuralFeature has an annotation with the given source, key, and value. Pass null for value to match any value."/>
      </eAnnotations>
      <eParameters name="annotationSource" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="key" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="value" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
  </eClassifiers>

  <!-- ========================================================================
       MetadataIndexWriter - Index maintenance operations (internal API)
       ======================================================================== -->
  <eClassifiers xsi:type="ecore:EClass" name="MetadataIndexWriter" abstract="true" interface="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Write interface for index maintenance. Used internally by MetadataService to keep the index in sync with registered packages."/>
    </eAnnotations>
    <!-- Index operations -->
    <eOperations name="indexPackage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Index a PackageMetadata and all its contained ClassMetadata and FeatureMetadata."/>
      </eAnnotations>
      <eParameters name="packageMetadata" eType="ecore:EClass metadata.ecore#//PackageMetadata"/>
    </eOperations>
    <eOperations name="indexClass">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Index a single ClassMetadata and all its contained FeatureMetadata."/>
      </eAnnotations>
      <eParameters name="classMetadata" eType="ecore:EClass metadata.ecore#//ClassMetadata"/>
    </eOperations>
    <eOperations name="indexFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Index a single FeatureMetadata."/>
      </eAnnotations>
      <eParameters name="featureMetadata" eType="ecore:EClass metadata.ecore#//FeatureMetadata"/>
    </eOperations>
    <!-- Remove operations -->
    <eOperations name="removePackage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Remove a PackageMetadata and all its contained metadata from the index."/>
      </eAnnotations>
      <eParameters name="packageMetadata" eType="ecore:EClass metadata.ecore#//PackageMetadata"/>
    </eOperations>
    <eOperations name="removeClass">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Remove a ClassMetadata and all its contained FeatureMetadata from the index."/>
      </eAnnotations>
      <eParameters name="classMetadata" eType="ecore:EClass metadata.ecore#//ClassMetadata"/>
    </eOperations>
    <eOperations name="removeFeature">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Remove a FeatureMetadata from the index."/>
      </eAnnotations>
      <eParameters name="featureMetadata" eType="ecore:EClass metadata.ecore#//FeatureMetadata"/>
    </eOperations>
    <eOperations name="clear">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Clear all index entries."/>
      </eAnnotations>
    </eOperations>
  </eClassifiers>

  <!-- ========================================================================
       MetadataIndex - Combined interface (extends Reader + Writer)
       ======================================================================== -->
  <eClassifiers xsi:type="ecore:EClass" name="MetadataIndex" abstract="true" interface="true"
      eSuperTypes="#//MetadataIndexReader #//MetadataIndexWriter">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Combined index interface for metadata lookups and maintenance. Extends both MetadataIndexReader (query operations) and MetadataIndexWriter (index maintenance). Implementations include MapBasedMetadataIndex (in-memory) and potentially LuceneMetadataIndex (future)."/>
    </eAnnotations>
  </eClassifiers>

  <!-- ========================================================================
       MetadataService - Main service interface
       ======================================================================== -->
  <eClassifiers xsi:type="ecore:EClass" name="MetadataService" abstract="true" interface="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Main service interface for accessing pre-computed model metadata. Provides package registration/lifecycle and access to the MetadataIndexReader for fast indexed queries."/>
    </eAnnotations>
    <eOperations name="getIndexReader" eType="#//MetadataIndexReader">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get the index reader for fast metadata lookups. The index is automatically maintained when packages are registered/unregistered."/>
      </eAnnotations>
    </eOperations>
    <eOperations name="registerPackage" eType="ecore:EClass metadata.ecore#//PackageMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Register an EPackage and build metadata for all its classes. Automatically indexes the metadata."/>
      </eAnnotations>
      <eParameters name="ePackage" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EPackage"/>
    </eOperations>
    <eOperations name="unregisterPackage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unregister an EPackage and remove all associated metadata. Automatically removes from index."/>
      </eAnnotations>
      <eParameters name="ePackage" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EPackage"/>
    </eOperations>
    <eOperations name="getPackageMetadata" eType="ecore:EClass metadata.ecore#//PackageMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get metadata for a package by namespace URI."/>
      </eAnnotations>
      <eParameters name="nsURI" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="getClassMetadata" eType="ecore:EClass metadata.ecore#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get metadata for an EClass."/>
      </eAnnotations>
      <eParameters name="eClass" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    </eOperations>
    <eOperations name="getClassMetadataByURI" eType="ecore:EClass metadata.ecore#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get metadata for an EClass by its full URI."/>
      </eAnnotations>
      <eParameters name="uri" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="getClassMetadataByName" eType="ecore:EClass metadata.ecore#//ClassMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get metadata for an EClass by name and package namespace URI."/>
      </eAnnotations>
      <eParameters name="className" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="nsURI" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="getFeatureMetadata" eType="ecore:EClass metadata.ecore#//FeatureMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get metadata for an EStructuralFeature."/>
      </eAnnotations>
      <eParameters name="feature" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    </eOperations>
    <eOperations name="getFeatureMetadataByURI" eType="ecore:EClass metadata.ecore#//FeatureMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get metadata for an EStructuralFeature by its full URI."/>
      </eAnnotations>
      <eParameters name="uri" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="getFeatureMetadataByName" eType="ecore:EClass metadata.ecore#//FeatureMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get metadata for an EStructuralFeature by feature name, class name, and package namespace URI."/>
      </eAnnotations>
      <eParameters name="featureName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="className" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="nsURI" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="getFeatureMetadataFromClass" eType="ecore:EClass metadata.ecore#//FeatureMetadata">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get metadata for an EStructuralFeature by feature name and ClassMetadata."/>
      </eAnnotations>
      <eParameters name="featureName" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
      <eParameters name="classMetadata" eType="ecore:EClass metadata.ecore#//ClassMetadata"/>
    </eOperations>
    <eOperations name="getPackageAspect" eType="ecore:EClass metadata.ecore#//PackageAspect">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get a specific aspect from an EPackage by aspect type ID."/>
      </eAnnotations>
      <eParameters name="ePackage" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EPackage"/>
      <eParameters name="aspectTypeId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="getClassAspect" eType="ecore:EClass metadata.ecore#//ClassAspect">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get a specific aspect from an EClass by aspect type ID."/>
      </eAnnotations>
      <eParameters name="eClass" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
      <eParameters name="aspectTypeId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="getFeatureAspect" eType="ecore:EClass metadata.ecore#//FeatureAspect">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get a specific aspect from an EStructuralFeature by aspect type ID."/>
      </eAnnotations>
      <eParameters name="feature" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
      <eParameters name="aspectTypeId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    </eOperations>
    <eOperations name="getRegistry" eType="ecore:EClass metadata.ecore#//MetadataRegistry">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get the full metadata registry for serialization/caching."/>
      </eAnnotations>
    </eOperations>
    <eOperations name="registerAspectProvider">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Register an AspectProvider to contribute aspects when packages are registered."/>
      </eAnnotations>
      <eParameters name="provider" eType="#//AspectProvider"/>
    </eOperations>
    <eOperations name="unregisterAspectProvider">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Unregister an AspectProvider."/>
      </eAnnotations>
      <eParameters name="provider" eType="#//AspectProvider"/>
    </eOperations>
    <eOperations name="getAspectProviders" upperBound="-1" eType="#//AspectProvider">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Get all registered AspectProviders."/>
      </eAnnotations>
    </eOperations>
  </eClassifiers>

  <!-- ========================================================================
       AspectProvider - Extension point for contributing aspects
       ======================================================================== -->
  <eClassifiers xsi:type="ecore:EClass" name="AspectProvider" abstract="true" interface="true">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Extension point for contributing aspects to model metadata."/>
    </eAnnotations>
    <eOperations name="getAspectTypeId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Returns the unique identifier for this aspect type (e.g., 'codec', 'orm')."/>
      </eAnnotations>
    </eOperations>
    <eOperations name="buildPackageAspect" eType="ecore:EClass metadata.ecore#//PackageAspect">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Build a PackageAspect for the given EPackage. Returns null if not applicable."/>
      </eAnnotations>
      <eParameters name="ePackage" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EPackage"/>
    </eOperations>
    <eOperations name="buildClassAspect" eType="ecore:EClass metadata.ecore#//ClassAspect">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Build a ClassAspect for the given EClass. Returns null if not applicable."/>
      </eAnnotations>
      <eParameters name="eClass" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EClass"/>
    </eOperations>
    <eOperations name="buildFeatureAspect" eType="ecore:EClass metadata.ecore#//FeatureAspect">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Build a FeatureAspect for the given EStructuralFeature. Returns null if not applicable."/>
      </eAnnotations>
      <eParameters name="feature" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EStructuralFeature"/>
    </eOperations>
    <eOperations name="buildAttributeAspect" eType="ecore:EClass metadata.ecore#//FeatureAspect">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Build a FeatureAspect for an EAttribute. Override for attribute-specific logic."/>
      </eAnnotations>
      <eParameters name="attribute" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EAttribute"/>
    </eOperations>
    <eOperations name="buildReferenceAspect" eType="ecore:EClass metadata.ecore#//FeatureAspect">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Build a FeatureAspect for an EReference. Override for reference-specific logic."/>
      </eAnnotations>
      <eParameters name="reference" eType="ecore:EClass http://www.eclipse.org/emf/2002/Ecore#//EReference"/>
    </eOperations>
  </eClassifiers>
</ecore:EPackage>
