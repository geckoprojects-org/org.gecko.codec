    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="Pre-computed metadata for an EClass. Contains resolved serialization configuration."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" name="package" eType="#//PackageMetadata"
