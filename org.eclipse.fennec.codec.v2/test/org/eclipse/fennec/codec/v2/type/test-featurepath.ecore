<?xml version="1.0" encoding="UTF-8"?>
<ecore:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ecore="http://www.eclipse.org/emf/2002/Ecore" name="testfeaturepath" nsURI="http://test.example.org/featurepath/1.0" nsPrefix="testfeaturepath">

  <!--
    Model for testing featurePath-based type discrimination.
    The discriminator value is read from a content field (e.g., info.sensorType)
    instead of the _type field.
    Uses unified annotation format with typeDiscriminatorPath.
  -->

  <!-- Info container that holds the discriminator value -->
  <eClassifiers xsi:type="ecore:EClass" name="SensorInfo">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="sensorType" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="manufacturer" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
  </eClassifiers>

  <!-- Abstract base with MAPPED strategy and featurePath discriminator -->
  <eClassifiers xsi:type="ecore:EClass" name="SensorReading" abstract="true">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="typeMapId" value="sensorTypes"/>
      <details key="typeDiscriminatorPath" value="info.sensorType"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="timestamp" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//ELong"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="info" eType="#//SensorInfo" containment="true"/>
  </eClassifiers>

  <!-- Concrete sensor types -->
  <eClassifiers xsi:type="ecore:EClass" name="TemperatureReading" eSuperTypes="#//SensorReading">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="typeMapId" value="sensorTypes"/>
      <details key="typeDiscriminator" value="temperature"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="celsius" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="HumidityReading" eSuperTypes="#//SensorReading">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="typeMapId" value="sensorTypes"/>
      <details key="typeDiscriminator" value="humidity"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="percentage" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <eClassifiers xsi:type="ecore:EClass" name="PressureReading" eSuperTypes="#//SensorReading">
    <eAnnotations source="http://eclipse.org/fennec/codec">
      <details key="typeMapId" value="sensorTypes"/>
      <details key="typeDiscriminator" value="pressure"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="hectopascal" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EDouble"/>
  </eClassifiers>

  <!-- Container for batch readings -->
  <eClassifiers xsi:type="ecore:EClass" name="SensorBatch">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="batchId" eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EString"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="readings" upperBound="-1" eType="#//SensorReading" containment="true"/>
  </eClassifiers>

</ecore:EPackage>
