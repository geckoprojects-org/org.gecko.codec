{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "definitions": {
           "CompleteResult": {
            "description": "The server's response to a completion/complete request",
            "properties": {
                "_meta": {
                    "description": "An array of completion values. Must not exceed 100 items.",
                    "items": {
                         "type": "string",
                         "enum": ["A", "B", "C"]
                    	  },
                     "type": "array"
                     }
                    },
            "type": "object"
        }
     }
 }