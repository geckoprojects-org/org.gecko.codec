-library: enableOSGi-Test

-runrequires: \
	bnd.identity;id='org.eclipse.fennec.codec.json',\
	bnd.identity;id='org.eclipse.fennec.codec.lorawan.test',\
	bnd.identity;id='org.apache.felix.gogo.command',\
	bnd.identity;id='org.apache.felix.gogo.shell'
	
-runbundles.test: \
	org.eclipse.fennec.codec.lorawan.test;version=snapshot

-runfw: org.apache.felix.framework

-runee: JavaSE-17


-runbundles: \
	assertj-core;version='[3.24.2,3.24.3)',\
	com.fasterxml.jackson.core.jackson-annotations;version='[3.0.0,3.0.1)',\
	junit-jupiter-api;version='[5.10.1,5.10.2)',\
	junit-jupiter-params;version='[5.10.1,5.10.2)',\
	junit-platform-commons;version='[1.10.1,1.10.2)',\
	net.bytebuddy.byte-buddy;version='[1.14.9,1.14.10)',\
	org.apache.felix.configadmin;version='[1.9.26,1.9.27)',\
	org.apache.felix.scr;version='[2.2.6,2.2.7)',\
	org.eclipse.emf.common;version='[2.29.0,2.29.1)',\
	org.eclipse.emf.ecore;version='[2.35.0,2.35.1)',\
	org.eclipse.emf.ecore.xmi;version='[2.36.0,2.36.1)',\
	org.eclipse.fennec.codec;version=snapshot,\
	org.eclipse.fennec.codec.info;version=snapshot,\
	org.eclipse.fennec.codec.info.model;version=snapshot,\
	org.eclipse.fennec.codec.json;version=snapshot,\
	org.eclipse.fennec.codec.lorawan.test;version=snapshot,\
	org.eclipse.fennec.dragino.message.model;version=snapshot,\
	org.eclipse.fennec.lorawan.uplink.model;version=snapshot,\
	org.gecko.emf.osgi.api;version='[6.3.0,6.3.1)',\
	org.gecko.emf.osgi.component.config;version='[6.3.0,6.3.1)',\
	org.gecko.emf.osgi.component.minimal;version='[6.3.0,6.3.1)',\
	org.opentest4j;version='[1.3.0,1.3.1)',\
	org.osgi.service.component;version='[1.5.1,1.5.2)',\
	org.osgi.test.common;version='[1.2.1,1.2.2)',\
	org.osgi.test.junit5;version='[1.2.1,1.2.2)',\
	org.osgi.test.junit5.cm;version='[1.2.1,1.2.2)',\
	org.osgi.util.converter;version='[1.0.9,1.0.10)',\
	org.osgi.util.function;version='[1.2.0,1.2.1)',\
	org.osgi.util.promise;version='[1.3.0,1.3.1)',\
	tools.jackson.core.jackson-core;version='[3.0.0,3.0.1)',\
	tools.jackson.core.jackson-databind;version='[3.0.0,3.0.1)',\
	org.apache.felix.gogo.command;version='[1.1.2,1.1.3)',\
	org.apache.felix.gogo.runtime;version='[1.1.6,1.1.7)',\
	org.apache.felix.gogo.shell;version='[1.1.4,1.1.5)',\
	org.eclipse.fennec.em310udl.mesage.model;version=snapshot