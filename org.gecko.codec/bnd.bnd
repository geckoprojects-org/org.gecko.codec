-library: enable-emf
Bundle-Name: Gecko Codec 
Bundle-Description: Gecko Project Codec Framework

-buildpath: \
	org.osgi.util.promise;version=latest,\
	org.gecko.codec.emfjson;version=project,\
	org.gecko.codec.info.model,\
	org.gecko.codec.info,\
	org.gecko.codec.constants,\
	com.fasterxml.jackson.core.jackson-annotations;version='3.0',\
	tools.jackson.core.jackson-core,\
	tools.jackson.core.jackson-databind
	
-testpath: \
	org.gecko.codec.test.models;version=project
